{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"noImplicitOverride": true,
		"plugins": [
			{
				"name": "@effect/language-service",
				"namespaceImportPackages": ["effect"],
				"importAliases": { "Array": "Array_", "Record": "Record_", "Function": "Function_" }
			}
		]
	},
	"include": ["plugins/**/*.ts", "plugins/**/*.tsx"]
}
